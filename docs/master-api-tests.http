Content-Type: application/json

{
  "name": "{{runName}}-Location",
  "locationSupervisor": "",
  "locationDescription": "Live verification",
  "organizationUnitId": {{organizationId}},
  "status": 1,
  "createdBy": {{employeeId}},
  "supervisorIds": [
    {{employeeId}}
  ],
  "subLocationNames": "Zone A, Zone B",
  "newSublocations": [
    {
      "name": "Zone A",
      "description": "First area",
      "status": 1
    },
    {
      "name": "Zone B",
      "description": "",
      "status": 1
    }
  ],
  "subLocations": [],
  "subLocationIds": [],
  "translations": [
    {
      "languageId": 1,
      "name": "Factory",
      "description": "Live verification",
      "subLocations": [
        {
          "name": "Zone A",
          "description": "First area"
        }
      ]
    }
  ]
}

> {%
    client.test("HTTP 200", function () { client.assert(response.status === 200); });
%}

