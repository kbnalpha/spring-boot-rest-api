    client.test("HTTP 200", function () { client.assert(response.status === 200); });
    client.global.set("roleId", response.body.results.id);
%}

### Create employee
POST {{baseUrl}}/api/User/CreateEmployee
Authorization: Basic {{username}} {{password}}
Content-Type: application/json

{
  "id": 0,
  "firstName": "{{runName}}",
  "middleName": "API",
  "lastName": "Tester",
  "dateOfBirth": "1994-04-03",
  "age": "32",
  "alias": "smoke",
  "country": 900001,
  "contractorId": 0,
  "dateOfJoining": null,
  "department": {{departmentId}},
  "designation": {{designationId}},
  "emailAddress": "{{runName}}@example.com",
  "hasAccess": true,
  "isMobileUser": false,
  "gender": 1,
  "phoneNumber": "9000000000",
  "status": 1,
  "userNumber": "{{runName}}",
  "userType": 1,
  "organizationUnitId": {{organizationId}},
  "profilePictureId": 0,
  "languageID": 900004,
  "userRoleIds": [
    {{roleId}}
  ]
}

> {%
    client.test("HTTP 200", function () { client.assert(response.status === 200); });
    client.global.set("employeeId", response.body.results);
%}

### Activate employee as system user
POST {{baseUrl}}/api/User/{{employeeId}}/ActivateSystemUser
Authorization: Basic {{username}} {{password}}
Content-Type: application/json

{
  "basicRoleId": {{roleId}},
  "scopes": [
    {
      "organizationUnitId": {{organizationId}},
      "includeDescendants": true
    }
  ]
}

> {%
    client.test("HTTP 200", function () { client.assert(response.status === 200); });
    client.global.set("accountEmail", response.body.results.username);
    client.global.set("accountId", response.body.results.id);
%}

### First login requires reset
POST {{baseUrl}}/api/Auth/authenticate
Content-Type: application/json

{
  "email": "{{accountEmail}}",
  "password": "{{temporaryPassword}}"
}

> {%
    client.test("HTTP 200", function () { client.assert(response.status === 200); });
%}

### Set first permanent password
POST {{baseUrl}}/api/Auth/FirstLoginPasswordReset
Authorization: Basic {{accountEmail}} {{temporaryPassword}}
Content-Type: application/json

{
  "currentPassword": "{{temporaryPassword}}",
  "newPassword": "Example-password-123",
  "confirmPassword": "Example-password-123"
}

> {%
    client.test("HTTP 200", function () { client.assert(response.status === 200); });
%}

