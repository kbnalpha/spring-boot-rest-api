# Run individually against disposable test records, not as a full collection.
# All DELETE requests require Admin/Super Admin; Admin is limited to assigned scope.
# Replace REPLACE_WITH_UNUSED_TEST_ID before executing a request.
@baseUrl = http://127.0.0.1:8080
@username = ehs-api
@password = REPLACE_WITH_API_PASSWORD
@recordId = REPLACE_WITH_UNUSED_TEST_ID

### Delete OrganizationUnit (permanent; dependencies return 409)
DELETE {{baseUrl}}/api/OrganizationUnit/{{recordId}}
Authorization: Basic {{username}} {{password}}

### Delete Department (permanent; dependencies return 409)
DELETE {{baseUrl}}/api/Department/{{recordId}}
Authorization: Basic {{username}} {{password}}

